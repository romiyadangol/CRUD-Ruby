<% articles.each do |article| %>
    <div class="article">
      <h2><%= link_to article.title, article_path(article) %></h2>
      <p><%= truncate(article.body, length: 100) %></p>
      <small>Written by <%= article.user.username %> in <%= article.organization.name %></small>
    </div>
  <% end %>
  